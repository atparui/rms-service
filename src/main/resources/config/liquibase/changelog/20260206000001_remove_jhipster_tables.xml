<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Remove old JHipster tables and migrate to RMS tables only.
        
        Migration Strategy:
        - RMS uses rms_user table (not jhi_user)
        - Roles managed via user_branch_role (not jhi_user_authority)
        - No need for jhi_authority or authority tables
    -->

    <changeSet id="20260206000001-1" author="system">
        <comment>Migrate any existing jhi_user data to rms_user (if needed)</comment>

        <sql>
            -- Only migrate if jhi_user has data that's not in rms_user
            -- This is a safety measure in case there's any orphaned data
            INSERT INTO rms_user (
                id, 
                external_user_id, 
                username, 
                email, 
                first_name, 
                last_name, 
                is_active, 
                last_sync_at,
                sync_status
            )
            SELECT 
                gen_random_uuid(),
                id,
                login,
                email,
                first_name,
                last_name,
                activated,
                NOW(),
                'MIGRATED'
            FROM jhi_user
            WHERE id NOT IN (
                SELECT external_user_id 
                FROM rms_user 
                WHERE external_user_id IS NOT NULL
            )
            ON CONFLICT (external_user_id) DO NOTHING;
        </sql>
    </changeSet>

    <changeSet id="20260206000001-2" author="system">
        <comment>Drop old JHipster user tables</comment>
        
        <!-- Drop join table first (has foreign keys) -->
        <dropTable tableName="jhi_user_authority" cascadeConstraints="true"/>
        
        <!-- Drop main user table -->
        <dropTable tableName="jhi_user" cascadeConstraints="true"/>
    </changeSet>

    <changeSet id="20260206000001-3" author="system">
        <comment>Drop old JHipster authority tables</comment>
        
        <!-- Drop legacy user_authority if it exists -->
        <sql>
            DROP TABLE IF EXISTS user_authority CASCADE;
        </sql>
        
        <!-- Drop jhi_authority table -->
        <sql>
            DROP TABLE IF EXISTS jhi_authority CASCADE;
        </sql>
        
        <!-- Drop authority table (renamed from jhi_authority, no longer needed) -->
        <!-- RMS uses user_branch_role for all role management -->
        <sql>
            DROP TABLE IF EXISTS authority CASCADE;
        </sql>
    </changeSet>

    <changeSet id="20260206000001-4" author="system">
        <comment>Add index on rms_user.external_user_id for OAuth2 lookups</comment>
        
        <createIndex indexName="idx_rms_user_external_user_id" tableName="rms_user">
            <column name="external_user_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="20260206000001-5" author="system">
        <comment>Add index on user_sync_log for reporting</comment>
        
        <createIndex indexName="idx_user_sync_log_user_id" tableName="user_sync_log">
            <column name="user_id"/>
        </createIndex>
        
        <createIndex indexName="idx_user_sync_log_synced_at" tableName="user_sync_log">
            <column name="synced_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>

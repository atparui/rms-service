<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <!--
        Added the entity RestaurantRole.
        
        This table defines valid roles for restaurant staff.
        Replaces the hardcoded string approach in user_branch_role.
    -->
    <changeSet id="20260205120000-1" author="rms-team">
        <createTable tableName="restaurant_role">
            <column name="name" type="varchar(50)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="display_name" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="varchar(500)">
                <constraints nullable="true"/>
            </column>
            <column name="is_active" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="sort_order" type="integer" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="${datetimeType}" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="${datetimeType}">
                <constraints nullable="true"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Seed standard restaurant roles (matching Keycloak role format with ROLE_ prefix) -->
    <changeSet id="20260205120000-2" author="rms-team">
        <comment>Load standard restaurant roles that align with Keycloak roles</comment>
        
        <!-- System Admin Role -->
        <insert tableName="restaurant_role">
            <column name="name" value="ROLE_ADMIN"/>
            <column name="display_name" value="System Administrator"/>
            <column name="description" value="Full system access with all permissions"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="sort_order" valueNumeric="1"/>
        </insert>
        
        <!-- Restaurant Staff Roles -->
        <insert tableName="restaurant_role">
            <column name="name" value="ROLE_MANAGER"/>
            <column name="display_name" value="Manager"/>
            <column name="description" value="Restaurant manager with full access to branch operations"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="sort_order" valueNumeric="2"/>
        </insert>
        
        <insert tableName="restaurant_role">
            <column name="name" value="ROLE_CHEF"/>
            <column name="display_name" value="Chef"/>
            <column name="description" value="Head chef responsible for kitchen operations"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="sort_order" valueNumeric="3"/>
        </insert>
        
        <insert tableName="restaurant_role">
            <column name="name" value="ROLE_WAITER"/>
            <column name="display_name" value="Waiter/Waitress"/>
            <column name="description" value="Server responsible for taking orders and serving customers"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="sort_order" valueNumeric="4"/>
        </insert>
        
        <insert tableName="restaurant_role">
            <column name="name" value="ROLE_CASHIER"/>
            <column name="display_name" value="Cashier"/>
            <column name="description" value="Handles payments and cash register operations"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="sort_order" valueNumeric="5"/>
        </insert>
        
        <insert tableName="restaurant_role">
            <column name="name" value="ROLE_HOST"/>
            <column name="display_name" value="Host/Hostess"/>
            <column name="description" value="Greets and seats customers, manages reservations"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="sort_order" valueNumeric="6"/>
        </insert>
        
        <insert tableName="restaurant_role">
            <column name="name" value="ROLE_BARTENDER"/>
            <column name="display_name" value="Bartender"/>
            <column name="description" value="Prepares and serves beverages"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="sort_order" valueNumeric="7"/>
        </insert>
        
        <!-- Customer Role -->
        <insert tableName="restaurant_role">
            <column name="name" value="ROLE_CUSTOMER"/>
            <column name="display_name" value="Customer"/>
            <column name="description" value="Customer with limited access to view menu and place orders"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="sort_order" valueNumeric="8"/>
        </insert>
        
        <!-- Additional operational roles (not currently used in permissions but available) -->
        <insert tableName="restaurant_role">
            <column name="name" value="ROLE_DELIVERY_DRIVER"/>
            <column name="display_name" value="Delivery Driver"/>
            <column name="description" value="Delivers orders to customers"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="sort_order" valueNumeric="9"/>
        </insert>
    </changeSet>

</databaseChangeLog>
